# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tarim_pazar
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Firebase Authentication (Web app API key; used for legacy password reset clients)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# WhatsApp Business Cloud API phone verification fallback
WHATSAPP_PHONE_AUTH_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_AUTH_TEMPLATE_NAME=tarim_pazar_dogrulama
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=tr
WHATSAPP_GRAPH_API_VERSION=v23.0

# File uploads (local for now, swap for S3 later)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
