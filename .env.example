# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tarim_pazar
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Firebase Authentication (Web app API key; used for legacy password reset clients)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Paid listing promotions (keep disabled until both stores are configured)
PROMOTIONS_ENABLED=false
APPLE_IAP_BUNDLE_ID=com.tarim.pazar
APPLE_IAP_APP_ID=your_numeric_app_apple_id
APPLE_IAP_ISSUER_ID=your_app_store_connect_issuer_id
APPLE_IAP_KEY_ID=your_in_app_purchase_key_id
APPLE_IAP_PRIVATE_KEY_BASE64=base64_encoded_p8_contents
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_ROOT_CA_PATHS=/run/secrets/AppleRootCA-G3.cer
APPLE_IAP_ENVIRONMENT=production
GOOGLE_PLAY_PACKAGE_NAME=com.tarim.pazar
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://api.tarim-pazar.com/api/webhooks/google/play
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=play-rtdn@your-project.iam.gserviceaccount.com

# File uploads (local for now, swap for S3 later)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
